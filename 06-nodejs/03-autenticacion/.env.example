# Copia este archivo como .env y ajusta los valores. El archivo .env no se sube al repositorio.
PORT=3000
SALT_ROUNDS=10

# Clave para firmar los tokens JWT. Usa un texto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_JWT_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
